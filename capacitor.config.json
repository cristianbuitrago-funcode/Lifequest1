{
  "appId": "com.cristianbuitrago.lifequest",
  "appName": "LifeQuest",
  "webDir": "www",
  "android": {
    "backgroundColor": "#030915"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#030915",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_lifequest",
      "iconColor": "#f0c451"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}
